  <license>AGPL-3.0-or-later</license><version>0.0.3-alpha.4</version><develStage>alpha</develStage>
  <compatibility><ver>6.16</ver></compatibility>
  <php_compatibility><ver>8.1</ver><ver>8.2</ver><ver>8.3</ver><ver>8.4</ver></php_compatibility>
  <classloader><psr0 prefix="CRM_" path="."/><psr4 prefix="Civi\" path="Civi"/></classloader>
  <upgrader>CiviMix\Schema\Civineonotify\AutomaticUpgrader</upgrader>
  <mixins><mixin>entity-types-php@2.0.0</mixin><mixin>mgd-php@2.0.0</mixin><mixin>menu-xml@1.0.0</mixin><mixin>setting-php@1.0.0</mixin><mixin>smarty@1.0.3</mixin><mixin>scan-classes@1.0.0</mixin></mixins>
