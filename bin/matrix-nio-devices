#!/usr/bin/env python3
"""List the other Matrix devices of the logged-in user without exposing secrets."""
from __future__ import annotations

import argparse
import asyncio
import json
import stat
import sys
from pathlib import Path

from nio import AsyncClient, AsyncClientConfig, KeysQueryResponse, SyncResponse


def private(path: Path, directory: bool = False) -> None:
  if (not path.is_dir() if directory else not path.is_file()) or stat.S_IMODE(path.stat().st_mode) & 0o077:
    raise ValueError('Protected Matrix path is not usable.')


async def main() -> int:
  parser = argparse.ArgumentParser(description=__doc__)
  parser.add_argument('--homeserver', required=True)
  parser.add_argument('--session-file', type=Path, required=True)
  parser.add_argument('--store-path', type=Path, required=True)
  arguments = parser.parse_args()
  private(arguments.session_file); private(arguments.store_path, True)
  session = json.loads(arguments.session_file.read_text())
  client = AsyncClient(arguments.homeserver, session['user_id'], device_id=session['device_id'], store_path=str(arguments.store_path), config=AsyncClientConfig(encryption_enabled=True, store_sync_tokens=True, request_timeout=20, max_timeouts=0))
  client.restore_login(session['user_id'], session['device_id'], session['access_token'])
  try:
    response = await client.sync(timeout=0, full_state=True)
    if not isinstance(response, SyncResponse): raise RuntimeError('Matrix device sync failed.')
    response = await client.keys_query()
    if not isinstance(response, KeysQueryResponse): raise RuntimeError('Matrix device query failed.')
    own_devices = client.device_store[session['user_id']]
    devices = [{'id': device_id, 'name': f"{getattr(device, 'display_name', '') or device_id} ({device_id})"} for device_id, device in own_devices.items() if device_id != session['device_id']]
    print(json.dumps({'devices': devices}, separators=(',', ':')))
    return 0
  finally:
    await client.close()


if __name__ == '__main__':
  try: raise SystemExit(asyncio.run(main()))
  except Exception:
    print('{"devices":[]}')
    raise SystemExit(1)
