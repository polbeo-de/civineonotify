#!/usr/bin/env python3
"""List other members of a Matrix room without exposing credentials."""
from __future__ import annotations

import argparse
import asyncio
import json
import stat
from pathlib import Path

from nio import AsyncClient, AsyncClientConfig, SyncResponse


def private(path: Path, directory: bool = False) -> None:
  if (not path.is_dir() if directory else not path.is_file()) or stat.S_IMODE(path.stat().st_mode) & 0o077:
    raise ValueError('Protected Matrix path is not usable.')


async def main() -> int:
  parser = argparse.ArgumentParser(description=__doc__)
  parser.add_argument('--homeserver', required=True); parser.add_argument('--session-file', type=Path, required=True)
  parser.add_argument('--store-path', type=Path, required=True); parser.add_argument('--room-id', required=True)
  arguments = parser.parse_args(); private(arguments.session_file); private(arguments.store_path, True)
  session = json.loads(arguments.session_file.read_text())
  client = AsyncClient(arguments.homeserver, session['user_id'], device_id=session['device_id'], store_path=str(arguments.store_path), config=AsyncClientConfig(encryption_enabled=True, store_sync_tokens=True, request_timeout=20, max_timeouts=0))
  client.restore_login(session['user_id'], session['device_id'], session['access_token'])
  try:
    response = await client.sync(timeout=0, full_state=True)
    if not isinstance(response, SyncResponse) or arguments.room_id not in client.rooms: raise RuntimeError('Matrix room sync failed.')
    room = client.rooms[arguments.room_id]
    members = [{'id': user_id, 'name': getattr(user, 'display_name', '') or user_id} for user_id, user in room.users.items() if user_id != session['user_id']]
    print(json.dumps({'members': members}, separators=(',', ':')))
    return 0
  finally:
    await client.close()


if __name__ == '__main__':
  try: raise SystemExit(asyncio.run(main()))
  except Exception:
    print('{"members":[]}')
    raise SystemExit(1)
