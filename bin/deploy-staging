#!/usr/bin/env bash
# Deploy the immutable current origin/staging snapshot to a CiviCRM staging host.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: bin/deploy-staging --host HOST --civi-root PATH --cv PATH [--ref origin/staging]

Only origin/staging is accepted. The script builds a validated ZIP from its
exact commit, transfers it, switches the extension directory, then enables and
upgrades CiviCRM. It never runs the notification worker.
USAGE
}

host=''
civi_root=''
cv=''
ref='origin/staging'
while (($#)); do
  case "$1" in
    --host) host=${2:?missing value}; shift 2 ;;
    --civi-root) civi_root=${2:?missing value}; shift 2 ;;
    --cv) cv=${2:?missing value}; shift 2 ;;
    --ref) ref=${2:?missing value}; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done
[[ -n "$host" && -n "$civi_root" && -n "$cv" ]] || { usage >&2; exit 2; }
[[ "$ref" == origin/staging ]] || { printf '%s\n' 'Staging deployments must use origin/staging.' >&2; exit 2; }

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"
git fetch --quiet origin staging
commit=$(git rev-parse --verify "${ref}^{commit}")
short_commit=${commit:0:12}
archive="dist/civineonotify-staging-${short_commit}.zip"
bin/build-extension-archive --ref "$commit" --output "$archive"

extension_dir='de.polbeo.civicrm.civineonotify'
remote_archive="/tmp/${extension_dir}-${short_commit}.zip"
rsync -az "$archive" "${host}:${remote_archive}"
ssh "$host" bash -s -- "$civi_root" "$cv" "$remote_archive" "$extension_dir" "$short_commit" <<'REMOTE'
set -euo pipefail
civi_root=$1
cv=$2
archive=$3
extension_dir=$4
short_commit=$5
extension_root="${civi_root%/}/ext"
target="${extension_root}/${extension_dir}"
stage="${extension_root}/.${extension_dir}.stage-${short_commit}"
backup="${extension_root}/.${extension_dir}.backup-${short_commit}"
[[ -d "$extension_root" && -f "$archive" ]] || { printf '%s\n' 'Missing extension root or deployment archive.' >&2; exit 1; }
[[ ! -e "$stage" && ! -e "$backup" ]] || { printf '%s\n' 'A deployment path already exists; inspect it before retrying.' >&2; exit 1; }
mkdir "$stage"
unzip -q "$archive" -d "$stage"
[[ -f "$stage/$extension_dir/info.xml" ]] || { printf '%s\n' 'Invalid extension archive.' >&2; exit 1; }
if [[ -e "$target" ]]; then mv "$target" "$backup"; fi
mv "$stage/$extension_dir" "$target"
rmdir "$stage"
cd "$civi_root"
"$cv" flush
"$cv" ext:enable "$extension_dir"
"$cv" ext:upgrade-db
"$cv" flush
printf 'Staging deployment complete: %s at %s\n' "$extension_dir" "$short_commit"
REMOTE
