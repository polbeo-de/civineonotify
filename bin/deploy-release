#!/usr/bin/env bash
# Install a validated release archive on a production CiviCRM host.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: bin/deploy-release --artifact FILE.zip --version VERSION --host HOST --civi-root PATH --cv PATH

Production accepts only a ZIP rebuilt byte-for-byte from the annotated Git tag
matching VERSION. It deliberately has no Git checkout or branch option.
USAGE
}

artifact=''
version=''
host=''
civi_root=''
cv=''
while (($#)); do
  case "$1" in
    --artifact) artifact=${2:?missing value}; shift 2 ;;
    --version) version=${2:?missing value}; shift 2 ;;
    --host) host=${2:?missing value}; shift 2 ;;
    --civi-root) civi_root=${2:?missing value}; shift 2 ;;
    --cv) cv=${2:?missing value}; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done
[[ -f "$artifact" && -n "$version" && -n "$host" && -n "$civi_root" && -n "$cv" ]] || { usage >&2; exit 2; }

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"
expected=$(mktemp "${TMPDIR:-/tmp}/civineonotify-release.XXXXXX.zip")
trap 'rm -f "$expected"' EXIT
bin/build-extension-archive --ref "$version" --version "$version" --require-annotated-tag --output "$expected" >/dev/null
[[ $(shasum -a 256 "$artifact" | awk '{print $1}') == $(shasum -a 256 "$expected" | awk '{print $1}') ]] || { printf '%s\n' 'Artifact does not match the validated release tag.' >&2; exit 1; }

extension_dir='de.polbeo.civicrm.civineonotify'
remote_archive="/tmp/${extension_dir}-${version}.zip"
rsync -az "$artifact" "${host}:${remote_archive}"
ssh "$host" bash -s -- "$civi_root" "$cv" "$remote_archive" "$extension_dir" "$version" <<'REMOTE'
set -euo pipefail
civi_root=$1
cv=$2
archive=$3
extension_dir=$4
version=$5
extension_root="${civi_root%/}/ext"
target="${extension_root}/${extension_dir}"
stage="${extension_root}/.${extension_dir}.release-${version}"
backup="${extension_root}/.${extension_dir}.backup-${version}"
[[ -d "$extension_root" && -f "$archive" && ! -e "$stage" && ! -e "$backup" ]] || { printf '%s\n' 'Unsafe production deployment state.' >&2; exit 1; }
mkdir "$stage"
unzip -q "$archive" -d "$stage"
[[ -f "$stage/$extension_dir/info.xml" ]] || { printf '%s\n' 'Invalid release archive.' >&2; exit 1; }
installed_version=$(sed -n 's:.*<version>\([^<]*\)</version>.*:\1:p' "$stage/$extension_dir/info.xml")
[[ "$installed_version" == "$version" ]] || { printf '%s\n' 'Release archive version mismatch.' >&2; exit 1; }
if [[ -e "$target" ]]; then mv "$target" "$backup"; fi
mv "$stage/$extension_dir" "$target"
rmdir "$stage"
cd "$civi_root"
"$cv" flush
"$cv" ext:enable "$extension_dir"
"$cv" ext:upgrade-db
"$cv" flush
printf 'Production release deployment complete: %s %s\n' "$extension_dir" "$version"
REMOTE
