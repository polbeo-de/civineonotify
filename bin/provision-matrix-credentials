#!/usr/bin/env bash
# Create a matrix-commander-rs credential bundle without ever putting the token
# in an argument, a CiviCRM setting, or a log line.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: provision-matrix-credentials --matrix-client /path/to/matrix-commander-rs \
  --homeserver https://matrix.example.org --user-login monitoring_bot \
  --room-id '!room:example.org' --password-stdin \
  --credentials-file /protected/credentials.json --store-path /protected/store
EOF
}

homeserver=''
room_id=''
password_file=''
password_stdin=0
remove_password_file=0
status_file=''
credentials_file=''
store_path=''
matrix_client=''
user_login=''
device_name='CiviNeo Notify'
timeout=30
stage='preparing'
sync=''

while (($#)); do
  case "$1" in
    --matrix-client|--homeserver|--user-login|--room-id|--password-file|--credentials-file|--store-path|--timeout|--device-name|--status-file|--sync)
      (($# >= 2)) || { usage >&2; exit 2; }
      case "$1" in
        --matrix-client) matrix_client="$2";; --homeserver) homeserver="$2";; --user-login) user_login="$2";; --room-id) room_id="$2";; --password-file) password_file="$2";;
        --credentials-file) credentials_file="$2";; --store-path) store_path="$2";; --timeout) timeout="$2";;
        --device-name) device_name="$2";; --status-file) status_file="$2";; --sync) sync="$2";;
      esac
      shift 2;;
    --password-stdin) password_stdin=1; shift;;
    --remove-password-file) remove_password_file=1; shift;;
    --help) usage; exit 0;;
    *) usage >&2; exit 2;;
  esac
done

# If a caller explicitly requested removal, honour it even when validation
# rejects a later argument before the full provisioning cleanup is installed.
remove_password_on_early_exit() {
  if [[ "$remove_password_file" -eq 1 && -n "$password_file" ]]; then rm -f -- "$password_file"; fi
}
trap remove_password_on_early_exit EXIT

[[ "$homeserver" =~ ^https://[^[:space:]]+$ ]] || { echo 'Homeserver must be an HTTPS URL.' >&2; exit 2; }
[[ "$room_id" =~ ^\![^/[:space:]]+:[^/[:space:]]+$ ]] || { echo 'Room ID must be an internal Matrix room ID.' >&2; exit 2; }
[[ -x "$matrix_client" && -n "$user_login" && ( -r "$password_file" || "$password_stdin" -eq 1 ) && -n "$credentials_file" && -n "$store_path" ]] || { echo 'An executable Matrix client, user login, password input and both destination paths are required.' >&2; exit 2; }
[[ "$timeout" =~ ^[1-9][0-9]*$ ]] || { echo 'Timeout must be a positive integer.' >&2; exit 2; }
[[ -z "$sync" || "$sync" == 'off' || "$sync" == 'full' ]] || { echo 'Sync must be off or full.' >&2; exit 2; }

umask 077
parent="$(dirname "$credentials_file")"
if [[ ! -d "$parent" ]]; then mkdir -p "$parent"; chmod 700 "$parent"; fi
parent_mode="$(stat -c '%a' "$parent")"
[[ $((8#$parent_mode & 8#077)) -eq 0 && -w "$parent" ]] || { echo 'Credentials parent directory must be private and writable.' >&2; exit 2; }
if [[ ! -d "$store_path" ]]; then mkdir -p "$store_path"; chmod 700 "$store_path"; fi
store_mode="$(stat -c '%a' "$store_path")"
[[ $((8#$store_mode & 8#077)) -eq 0 && -w "$store_path" ]] || { echo 'E2EE store directory must be private and writable.' >&2; exit 2; }
runtime="$(mktemp -d "${TMPDIR:-/tmp}/civineonotify-matrix.XXXXXX")"
chmod 700 "$runtime"
write_status() {
  [[ -n "$status_file" ]] || return 0
  printf '%s\n' "$1" >"${status_file}.tmp"
  chmod 600 "${status_file}.tmp"
  mv -f "${status_file}.tmp" "$status_file"
}
cleanup() {
  local rc=$?
  if [[ "$rc" -eq 0 ]]; then write_status succeeded; else write_status "failed:${stage}"; fi
  if [[ "$remove_password_file" -eq 1 && -n "$password_file" ]]; then rm -f "$password_file"; fi
  rm -rf "$runtime"
  exit "$rc"
}
trap cleanup EXIT
trap 'write_status "failed:${stage}"; exit 143' HUP INT TERM
write_status "running:${stage}"

# matrix-commander-rs reads the password from standard input. It creates its
# own new device, credentials file and persistent E2EE store in one operation.
stage='creating-device'
write_status "running:${stage}"
if [[ "$password_stdin" -eq 1 ]]; then cat >"$runtime/password"; else cat "$password_file" >"$runtime/password"; fi
tr -d '\r\n' <"$runtime/password" >"$runtime/password.normalized"
mv "$runtime/password.normalized" "$runtime/password"
[[ -s "$runtime/password" ]] || { echo 'Password file is empty.' >&2; exit 2; }
chmod 600 "$runtime/password"
login_command=(
  "$matrix_client" --credentials "$credentials_file" --store "$store_path" --timeout "$timeout"
  --login password --homeserver "${homeserver%/}" --user-login "$user_login"
  --device "$device_name" --room-default "$room_id"
)
if [[ -n "$sync" ]]; then login_command+=(--sync "$sync"); fi
"${login_command[@]}" <"$runtime/password" >"$runtime/login.out" 2>&1 || { echo 'Matrix client login failed.' >&2; exit 8; }
chmod 600 "$credentials_file"
stage='checking-identity'
write_status "running:${stage}"
"$matrix_client" --credentials "$credentials_file" --store "$store_path" --timeout "$timeout" --whoami --output json >"$runtime/whoami.out" 2>&1 || { echo 'Matrix client identity check failed.' >&2; exit 8; }
printf 'Created a protected Matrix device, credentials file and E2EE store. Next: verify the device, then run the transport test.\n'
