#!/usr/bin/env bash
# Create a matrix-commander-rs credential bundle without ever putting the token
# in an argument, a CiviCRM setting, or a log line.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: provision-matrix-credentials --homeserver https://matrix.example.org \
  --room-id '!room:example.org' --access-token-file /protected/token \
  --credentials-file /protected/credentials.json --store-path /protected/store
EOF
}

homeserver=''
room_id=''
token_file=''
credentials_file=''
store_path=''
timeout=30

while (($#)); do
  case "$1" in
    --homeserver|--room-id|--access-token-file|--credentials-file|--store-path|--timeout)
      (($# >= 2)) || { usage >&2; exit 2; }
      case "$1" in
        --homeserver) homeserver="$2";; --room-id) room_id="$2";; --access-token-file) token_file="$2";;
        --credentials-file) credentials_file="$2";; --store-path) store_path="$2";; --timeout) timeout="$2";;
      esac
      shift 2;;
    --help) usage; exit 0;;
    *) usage >&2; exit 2;;
  esac
done

[[ "$homeserver" =~ ^https://[^[:space:]]+$ ]] || { echo 'Homeserver must be an HTTPS URL.' >&2; exit 2; }
[[ "$room_id" =~ ^\![^/[:space:]]+:[^/[:space:]]+$ ]] || { echo 'Room ID must be an internal Matrix room ID.' >&2; exit 2; }
[[ -r "$token_file" && -n "$credentials_file" && -n "$store_path" ]] || { echo 'A readable token file and both destination paths are required.' >&2; exit 2; }
[[ "$timeout" =~ ^[1-9][0-9]*$ ]] || { echo 'Timeout must be a positive integer.' >&2; exit 2; }
command -v curl >/dev/null || { echo 'curl is required.' >&2; exit 10; }
command -v jq >/dev/null || { echo 'jq is required.' >&2; exit 10; }

umask 077
parent="$(dirname "$credentials_file")"
mkdir -p "$parent" "$store_path"
chmod 700 "$parent" "$store_path"
runtime="$(mktemp -d "${TMPDIR:-/tmp}/civineonotify-matrix.XXXXXX")"
chmod 700 "$runtime"
trap 'rm -rf "$runtime"' EXIT

# A token is a single value. Strip only the conventional line ending from its
# protected upload/file; reject embedded newlines so it cannot alter curl.conf.
tr -d '\r\n' <"$token_file" >"$runtime/token"
[[ -s "$runtime/token" ]] || { echo 'Access-token file is empty.' >&2; exit 2; }
chmod 600 "$runtime/token"
token="$(<"$runtime/token")"
printf 'header = "Authorization: Bearer %s"\nheader = "Accept: application/json"\n' "$token" >"$runtime/curl.conf"
unset token
chmod 600 "$runtime/curl.conf"

curl -fsS --config "$runtime/curl.conf" --connect-timeout "$timeout" --max-time "$timeout" \
  "${homeserver%/}/_matrix/client/v3/account/whoami" >"$runtime/whoami.json"
user_id="$(jq -r '.user_id // empty' "$runtime/whoami.json")"
device_id="$(jq -r '.device_id // empty' "$runtime/whoami.json")"
[[ -n "$user_id" && -n "$device_id" ]] || { echo 'Token identity response has no user_id or device_id.' >&2; exit 8; }

jq -n --arg homeserver "${homeserver%/}" --arg user_id "$user_id" --arg device_id "$device_id" \
  --arg room_id "$room_id" --rawfile access_token "$runtime/token" \
  '{homeserver:$homeserver,user_id:$user_id,access_token:$access_token,device_id:$device_id,room_id:$room_id,refresh_token:null}' \
  >"$runtime/credentials.json"
chmod 600 "$runtime/credentials.json"
mv -f "$runtime/credentials.json" "$credentials_file"
chmod 600 "$credentials_file"
printf 'Created protected credentials file and E2EE store. Next: configure the transport and run its connection test.\n'
